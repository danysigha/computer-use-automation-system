{
  "name": "computer-use-automation-system",
  "version": "0.1.0",
  "private": true,
  "description": "Record-once / replay-many computer-use automation: an LLM-driven discovery run distils a versioned capability artifact, which a keyless deterministic engine replays under policy guardrails.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "app": "node sample-app/server.ts",
    "discover": "node src/cli/discover.ts",
    "replay": "node src/cli/replay.ts",
    "spike": "node scripts/spike.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openai": "^7.15.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
