# Copy to `.env` and fill in. Nothing here is committed except this template.
# Precedence everywhere in this project: env var > policy.json > code default.

# --- Discovery agent (required for `npm run discover` only; replay is keyless) ---
OPENAI_API_KEY=
# Optional: override the model used by the discovery agent.
# OPENAI_MODEL=

# --- Sample app ("Atlas Core Console" fixture) ---
# Must be allowlisted in policy/policy.json, or preflight stops with the fix spelled out.
PORT=4173
# Advertised build marker (PLAN §26 drift preflight). Change these to simulate a
# different tenant build and watch replay preflight refuse (or `--allow-drift` through).
APP_PRODUCT=atlas-console
APP_VARIANT=base
APP_VERSION=0.1

# --- Operator console / control bus ---
BUS_PORT=4517

# --- Policy ---
# The guardrail document: allowlist, risk rules, redaction patterns, timing (§6).
# A missing or malformed file is a startup error, never a default-open.
# POLICY_PATH=policy/policy.json

# Numeric knobs are overridable per field, as POLICY_<SECTION>_<KEY> — derived from
# the policy's own keys, so a knob added there is overridable the moment it exists.
# Arrays (backoffMs) are file-only: a comma-separated list in an env var is a format
# nobody validates, so tests that need a shrunk timing use a policy file instead.
#
# Timing (§6): waitForMs is the step timeout, retries/backoffMs the retry budget,
# escalationTimeoutMs how long a human handback may stay unresolved.
# POLICY_TIMING_WAITFORMS=10000
# POLICY_TIMING_RETRIES=2
# POLICY_TIMING_ESCALATIONTIMEOUTMS=600000
#
# Discovery agent (§8): the stuck detector's thresholds — total tool calls, calls
# without observable progress, and repeats of one action.
# POLICY_AGENT_MAXTOOLCALLS=25
# POLICY_AGENT_NOPROGRESSACTIONS=5
# POLICY_AGENT_REPEATLIMIT=3
