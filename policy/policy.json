{
  "allowlist": {
    "origins": ["http://localhost:4173"],
    "routes": [{ "pattern": "^/member/", "allow": true }],
    "denyRoutes": ["/admin/"],
    "actions": ["navigate", "click", "type", "select", "press", "wait", "read", "extract", "screenshot"]
  },
  "risk": {
    "approvalRequired": [
      {
        "matches": { "action": "click", "text": "Close account" },
        "note": "irreversible: closes the member's account"
      },
      {
        "matches": { "action": "type", "fieldName": "/password|ssn|taxid/i" },
        "note": "sensitive field"
      }
    ]
  },
  "redact": {
    "fieldPatterns": ["password", "ssn", "account_number"],
    "outputIds": []
  },
  "recoverableDialogs": [{ "text": "/confirm activation of account/i", "response": "accept" }],
  "outcomes": [
    {
      "code": "NO_SUCH_ENTITY",
      "message": "No member {memberId} on file",
      "sample": "No member 99999 on file",
      "pattern": "No member \\d{5} on file"
    },
    {
      "code": "RECORD_LOCKED",
      "message": "Member {memberId} is locked",
      "sample": "Member 12345 is locked",
      "pattern": "Member \\d{5} is locked"
    },
    {
      "code": "PERMISSION_DENIED",
      "message": "Access to member {memberId} is restricted",
      "sample": "Access to member 12345 is restricted",
      "pattern": "Access to member \\d{5} is restricted"
    }
  ],
  "timing": {
    "waitForMs": 10000,
    "retries": 2,
    "backoffMs": [1000, 3000],
    "escalationTimeoutMs": 600000
  },
  "agent": {
    "maxToolCalls": 25,
    "noProgressActions": 5,
    "repeatLimit": 3
  }
}
